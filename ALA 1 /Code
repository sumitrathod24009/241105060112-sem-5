<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🔐 Secure Messaging · AES + RSA</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
        }
        body {
            background: linear-gradient(145deg, #f6f9fc 0%, #e9f0f5 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 2rem 1rem;
        }
        .app-card {
            max-width: 1100px;
            width: 100%;
            background: rgba(255, 255, 255, 0.75);
            backdrop-filter: blur(10px);
            border-radius: 40px;
            padding: 2rem 2.5rem;
            box-shadow: 0 20px 40px rgba(0, 20, 30, 0.15), 0 6px 12px rgba(0,0,0,0.05);
            border: 1px solid rgba(255,255,255,0.5);
            transition: all 0.2s;
        }
        h1 {
            font-size: 2.2rem;
            font-weight: 600;
            letter-spacing: -0.02em;
            background: linear-gradient(135deg, #0b2b3d, #1b4a6b);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 0.25rem;
        }
        .subhead {
            color: #2c4c6e;
            font-weight: 400;
            font-size: 0.95rem;
            margin-bottom: 2rem;
            border-left: 4px solid #3b82f6;
            padding-left: 1rem;
            background: rgba(59, 130, 246, 0.06);
            border-radius: 0 12px 12px 0;
        }
        .grid-2col {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
        }
        @media (max-width: 720px) {
            .grid-2col {
                grid-template-columns: 1fr;
                gap: 1.8rem;
            }
            .app-card {
                padding: 1.5rem;
            }
        }
        .panel {
            background: white;
            border-radius: 28px;
            padding: 1.6rem 1.8rem;
            box-shadow: 0 8px 18px rgba(0, 20, 30, 0.06);
            border: 1px solid rgba(255,255,255,0.7);
            transition: 0.15s;
        }
        .panel h2 {
            font-weight: 500;
            font-size: 1.2rem;
            color: #0b2b3d;
            display: flex;
            align-items: center;
            gap: 10px;
            margin-top: 0;
            margin-bottom: 1.2rem;
            border-bottom: 1px solid #e5edf3;
            padding-bottom: 0.75rem;
        }
        .key-badge {
            background: #eef4fa;
            border-radius: 60px;
            padding: 0.2rem 0.9rem;
            font-size: 0.7rem;
            font-weight: 600;
            color: #1f4b6e;
            letter-spacing: 0.3px;
            margin-left: auto;
        }
        textarea, input[type="text"] {
            width: 100%;
            border: 1px solid #d9e2ea;
            border-radius: 20px;
            padding: 0.9rem 1.2rem;
            font-size: 0.95rem;
            background: #fafdff;
            transition: 0.15s;
            resize: vertical;
            font-family: 'Menlo', 'Cascadia Code', monospace;
        }
        textarea:focus, input:focus {
            outline: none;
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
            background: white;
        }
        .btn-group {
            display: flex;
            flex-wrap: wrap;
            gap: 0.6rem;
            margin: 1rem 0 0.5rem;
        }
        .btn {
            border: none;
            background: #eef4fa;
            padding: 0.6rem 1.4rem;
            border-radius: 60px;
            font-weight: 500;
            font-size: 0.9rem;
            color: #1b3a55;
            cursor: pointer;
            transition: 0.15s;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            border: 1px solid transparent;
        }
        .btn-primary {
            background: #1a4b6d;
            color: white;
            box-shadow: 0 2px 6px rgba(26, 75, 109, 0.25);
        }
        .btn-primary:hover {
            background: #0f3a55;
            transform: scale(0.97);
        }
        .btn-outline {
            background: transparent;
            border: 1px solid #b8cfdf;
        }
        .btn-outline:hover {
            background: #e3edf6;
        }
        .btn-success {
            background: #1f8b4c;
            color: white;
        }
        .btn-success:hover {
            background: #16733e;
        }
        .btn:active {
            transform: scale(0.95);
        }
        .status-box {
            background: #eef4fa;
            border-radius: 18px;
            padding: 0.8rem 1.2rem;
            margin: 1rem 0 0.5rem;
            font-size: 0.8rem;
            color: #1f405b;
            border-left: 4px solid #3b82f6;
            word-break: break-all;
            max-height: 100px;
            overflow-y: auto;
        }
        .cipher-output {
            background: #0d1f2c;
            color: #b7e0ff;
            padding: 0.8rem 1.2rem;
            border-radius: 18px;
            font-family: 'Menlo', monospace;
            font-size: 0.8rem;
            word-break: break-all;
            max-height: 120px;
            overflow-y: auto;
            margin: 0.5rem 0;
        }
        .flex-row {
            display: flex;
            gap: 0.8rem;
            flex-wrap: wrap;
            align-items: center;
        }
        .label-sm {
            font-size: 0.75rem;
            font-weight: 600;
            color: #2c5779;
            letter-spacing: 0.3px;
            text-transform: uppercase;
        }
        .mt-2 { margin-top: 1rem; }
        .mb-1 { margin-bottom: 0.5rem; }
        .gap-1 { gap: 0.5rem; }
        .badge {
            background: #d2e3f0;
            padding: 0.2rem 0.8rem;
            border-radius: 40px;
            font-size: 0.7rem;
            font-weight: 600;
        }
        .footer-note {
            margin-top: 2rem;
            text-align: center;
            font-size: 0.8rem;
            color: #3a688a;
            border-top: 1px solid #dce8f0;
            padding-top: 1.5rem;
        }
    </style>
</head>
<body>
<div class="app-card">
    <h1>🔐 CipherLink</h1>
    <div class="subhead">AES-256-GCM · RSA-OAEP hybrid encryption · messages stay in your browser</div>

    <div class="grid-2col">
        <!-- LEFT: SENDER -->
        <div class="panel">
            <h2>📤 Sender <span class="key-badge">AES + RSA</span></h2>

            <div class="mb-1 label-sm">📝 Message</div>
            <textarea id="plaintextInput" rows="3" placeholder="Type your secret message...">Hello, this is a secure message.</textarea>

            <div class="btn-group">
                <button id="encryptBtn" class="btn btn-primary">🔒 Encrypt &amp; Send</button>
                <button id="randomMsgBtn" class="btn btn-outline">🎲 Random</button>
                <button id="clearSenderBtn" class="btn btn-outline">✕ Clear</button>
            </div>

            <div class="mt-2 label-sm">🔑 AES Key (encrypted with RSA)</div>
            <div id="encryptedKeyDisplay" class="cipher-output" style="background:#1d3345;">—</div>

            <div class="label-sm">📦 Ciphertext (AES-GCM)</div>
            <div id="ciphertextDisplay" class="cipher-output" style="background:#1d3345;">—</div>

            <div style="margin-top:0.8rem; display: flex; gap: 0.5rem; flex-wrap: wrap;">
                <button id="copyEncryptedKeyBtn" class="btn btn-outline" style="font-size:0.75rem;">📋 Copy enc key</button>
                <button id="copyCiphertextBtn" class="btn btn-outline" style="font-size:0.75rem;">📋 Copy cipher</button>
            </div>
        </div>

        <!-- RIGHT: RECIPIENT -->
        <div class="panel">
            <h2>📥 Recipient <span class="key-badge">RSA private</span></h2>

            <div class="label-sm">🔑 RSA Private Key (PEM)</div>
            <div style="display: flex; gap: 6px; margin: 4px 0 8px;">
                <button id="generateRsaBtn" class="btn btn-success" style="flex:1;">🔄 Generate RSA key pair</button>
            </div>
            <textarea id="rsaPrivateKeyInput" rows="4" placeholder="Paste RSA private key (PKCS8 PEM)">-----BEGIN PRIVATE KEY-----
MIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQC6p4TqJ...
-----END PRIVATE KEY-----</textarea>
            <div style="font-size:0.7rem; color:#3f6c8f; margin: 2px 0 8px;">(demo key – use "Generate" for real encryption)</div>

            <div class="flex-row" style="margin: 8px 0;">
                <div style="flex:1;">
                    <div class="label-sm">🔓 Decrypted message</div>
                    <textarea id="decryptedMessageDisplay" rows="3" readonly style="background:#f3f8fe; color:#0a2a3f; resize:vertical;">—</textarea>
                </div>
            </div>

            <div class="btn-group">
                <button id="decryptBtn" class="btn btn-primary">🔓 Decrypt with RSA</button>
                <button id="pasteFromSenderBtn" class="btn btn-outline">📥 Paste from sender</button>
                <button id="clearRecipientBtn" class="btn btn-outline">✕ Clear</button>
            </div>

            <div class="status-box" id="statusMessage" style="border-left-color: #2b7a4b;">Ready. Generate RSA keys or paste your private key.</div>
        </div>
    </div>

    <!-- hidden field for encrypted key / ciphertext transfer -->
    <div style="display: none;" id="hiddenTransfer"></div>

    <div class="footer-note">
        ⚡ AES-256-GCM (symmetric) · RSA-2048 OAEP (asymmetric) · keys never leave your browser.
    </div>
</div>

<script>
    (function() {
        "use strict";

        // --- DOM refs ---
        const plaintextInput = document.getElementById('plaintextInput');
        const encryptedKeyDisplay = document.getElementById('encryptedKeyDisplay');
        const ciphertextDisplay = document.getElementById('ciphertextDisplay');
        const rsaPrivateKeyInput = document.getElementById('rsaPrivateKeyInput');
        const decryptedMessageDisplay = document.getElementById('decryptedMessageDisplay');
        const statusMessage = document.getElementById('statusMessage');

        const encryptBtn = document.getElementById('encryptBtn');
        const decryptBtn = document.getElementById('decryptBtn');
        const generateRsaBtn = document.getElementById('generateRsaBtn');
        const randomMsgBtn = document.getElementById('randomMsgBtn');
        const clearSenderBtn = document.getElementById('clearSenderBtn');
        const clearRecipientBtn = document.getElementById('clearRecipientBtn');
        const pasteFromSenderBtn = document.getElementById('pasteFromSenderBtn');
        const copyEncryptedKeyBtn = document.getElementById('copyEncryptedKeyBtn');
        const copyCiphertextBtn = document.getElementById('copyCiphertextBtn');

        // --- helper: status ---
        function setStatus(msg, isError = false) {
            statusMessage.textContent = msg;
            statusMessage.style.borderLeftColor = isError ? '#b91c1c' : '#2b7a4b';
            if (isError) {
                statusMessage.style.background = '#fff0f0';
            } else {
                statusMessage.style.background = '#eef4fa';
            }
        }

        // --- generate RSA key pair (2048) ---
        async function generateRSAKeyPair() {
            try {
                setStatus('⏳ Generating RSA-2048 key pair...');
                const keyPair = await window.crypto.subtle.generateKey(
                    {
                        name: 'RSA-OAEP',
                        modulusLength: 2048,
                        publicExponent: new Uint8Array([1, 0, 1]),
                        hash: 'SHA-256',
                    },
                    true,
                    ['encrypt', 'decrypt']
                );
                // export private key as PKCS8 PEM
                const privExported = await window.crypto.subtle.exportKey('pkcs8', keyPair.privateKey);
                const privPem = arrayBufferToPem(privExported, 'PRIVATE KEY');
                rsaPrivateKeyInput.value = privPem;

                // store public key in a hidden global for encryption
                const pubExported = await window.crypto.subtle.exportKey('spki', keyPair.publicKey);
                const pubPem = arrayBufferToPem(pubExported, 'PUBLIC KEY');
                window._rsaPublicKeyPem = pubPem; // stored for sender

                // also store private key object for decryption
                window._rsaPrivateKey = keyPair.privateKey;

                setStatus('✅ RSA key pair generated! Public key stored for encryption.');
                return true;
            } catch (err) {
                console.error(err);
                setStatus('❌ RSA generation failed: ' + err.message, true);
                return false;
            }
        }

        // helper: ArrayBuffer -> PEM
        function arrayBufferToPem(buffer, label) {
            const binary = String.fromCharCode(...new Uint8Array(buffer));
            const b64 = btoa(binary);
            const lines = b64.match(/.{1,64}/g) || [];
            return `-----BEGIN ${label}-----\n${lines.join('\n')}\n-----END ${label}-----\n`;
        }

        // helper: PEM -> ArrayBuffer
        function pemToArrayBuffer(pem, label) {
            const lines = pem.split('\n');
            let b64 = '';
            let inKey = false;
            for (const line of lines) {
                if (line.includes(`BEGIN ${label}`)) { inKey = true; continue; }
                if (line.includes(`END ${label}`)) { break; }
                if (inKey) b64 += line.trim();
            }
            if (!b64) throw new Error(`Invalid PEM for ${label}`);
            const binary = atob(b64);
            const bytes = new Uint8Array(binary.length);
            for (let i = 0; i < binary.length; i++) {
                bytes[i] = binary.charCodeAt(i);
            }
            return bytes.buffer;
        }

        // --- import RSA public key from PEM ---
        async function importRsaPublicKey(pem) {
            try {
                const spki = pemToArrayBuffer(pem, 'PUBLIC KEY');
                return await window.crypto.subtle.importKey(
                    'spki',
                    spki,
                    { name: 'RSA-OAEP', hash: 'SHA-256' },
                    false,
                    ['encrypt']
                );
            } catch (e) {
                throw new Error('Failed to import RSA public key: ' + e.message);
            }
        }

        // --- import RSA private key from PEM ---
        async function importRsaPrivateKey(pem) {
            try {
                const pkcs8 = pemToArrayBuffer(pem, 'PRIVATE KEY');
                return await window.crypto.subtle.importKey(
                    'pkcs8',
                    pkcs8,
                    { name: 'RSA-OAEP', hash: 'SHA-256' },
                    false,
                    ['decrypt']
                );
            } catch (e) {
                throw new Error('Failed to import RSA private key: ' + e.message);
            }
        }

        // --- AES-GCM encryption (returns { ciphertext, iv, aesKey }) ---
        async function aesEncrypt(plaintext) {
            const encoder = new TextEncoder();
            const data = encoder.encode(plaintext);

            // generate AES key (256-bit)
            const aesKey = await window.crypto.subtle.generateKey(
                { name: 'AES-GCM', length: 256 },
                true,
                ['encrypt', 'decrypt']
            );

            // generate random IV (12 bytes recommended for GCM)
            const iv = window.crypto.getRandomValues(new Uint8Array(12));

            const encrypted = await window.crypto.subtle.encrypt(
                { name: 'AES-GCM', iv: iv },
                aesKey,
                data
            );

            // export AES key for RSA encryption (raw)
            const rawAesKey = await window.crypto.subtle.exportKey('raw', aesKey);

            return {
                ciphertext: new Uint8Array(encrypted),
                iv: iv,
                aesKeyRaw: new Uint8Array(rawAesKey),
                aesKey: aesKey,
            };
        }

        // --- AES-GCM decryption ---
        async function aesDecrypt(ciphertext, iv, aesKeyRaw) {
            try {
                const aesKey = await window.crypto.subtle.importKey(
                    'raw',
                    aesKeyRaw,
                    { name: 'AES-GCM' },
                    false,
                    ['decrypt']
                );
                const decrypted = await window.crypto.subtle.decrypt(
                    { name: 'AES-GCM', iv: iv },
                    aesKey,
                    ciphertext
                );
                const decoder = new TextDecoder();
                return decoder.decode(decrypted);
            } catch (e) {
                throw new Error('AES decryption failed: ' + e.message);
            }
        }

        // --- RSA encrypt (OAEP) ---
        async function rsaEncrypt(data, publicKeyPem) {
            const publicKey = await importRsaPublicKey(publicKeyPem);
            const encrypted = await window.crypto.subtle.encrypt(
                { name: 'RSA-OAEP' },
                publicKey,
                data
            );
            return new Uint8Array(encrypted);
        }

        // --- RSA decrypt (OAEP) using private key object or PEM ---
        async function rsaDecrypt(encryptedData, privateKey) {
            // privateKey can be CryptoKey or PEM string
            let key = privateKey;
            if (typeof privateKey === 'string') {
                key = await importRsaPrivateKey(privateKey);
            }
            const decrypted = await window.crypto.subtle.decrypt(
                { name: 'RSA-OAEP' },
                key,
                encryptedData
            );
            return new Uint8Array(decrypted);
        }

        // --- ENCRYPT FLOW (sender) ---
        async function handleEncrypt() {
            const plaintext = plaintextInput.value.trim();
            if (!plaintext) {
                setStatus('⚠️ Please enter a message to encrypt.', true);
                return;
            }

            // get public key (from generated or stored)
            let pubPem = window._rsaPublicKeyPem;
            if (!pubPem) {
                // try to extract from the private key input? but we need public; user must generate.
                setStatus('⚠️ No RSA public key. Please generate RSA keys first (Recipient panel).', true);
                return;
            }

            try {
                setStatus('⏳ Encrypting with AES + RSA...');

                // 1. AES encrypt
                const aesResult = await aesEncrypt(plaintext);
                const { ciphertext, iv, aesKeyRaw } = aesResult;

                // combine IV + ciphertext for transmission (we need IV for decryption)
                // store as base64: iv (12 bytes) + ciphertext
                const combined = new Uint8Array(iv.length + ciphertext.length);
                combined.set(iv, 0);
                combined.set(ciphertext, iv.length);
                const combinedB64 = btoa(String.fromCharCode(...combined));
                ciphertextDisplay.textContent = combinedB64;

                // 2. RSA encrypt AES key
                const rsaEncryptedKey = await rsaEncrypt(aesKeyRaw, pubPem);
                const rsaKeyB64 = btoa(String.fromCharCode(...rsaEncryptedKey));
                encryptedKeyDisplay.textContent = rsaKeyB64;

                // store for recipient copy
                window._lastEncryptedKey = rsaKeyB64;
                window._lastCiphertext = combinedB64;

                setStatus('✅ Message encrypted. Copy the AES key (RSA-encrypted) and ciphertext to recipient.');
            } catch (err) {
                console.error(err);
                setStatus('❌ Encryption error: ' + err.message, true);
            }
        }

        // --- DECRYPT FLOW (recipient) ---
        async function handleDecrypt() {
            const encKeyB64 = encryptedKeyDisplay.textContent;
            const cipherB64 = ciphertextDisplay.textContent;
            if (!encKeyB64 || encKeyB64 === '—' || !cipherB64 || cipherB64 === '—') {
                setStatus('⚠️ No encrypted key or ciphertext. Paste or encrypt first.', true);
                return;
            }

            // get private key
            let privKey = window._rsaPrivateKey;
            const privPem = rsaPrivateKeyInput.value.trim();
            if (!privKey && !privPem) {
                setStatus('⚠️ No RSA private key. Paste or generate one.', true);
                return;
            }

            try {
                setStatus('⏳ Decrypting AES key with RSA...');

                // 1. decode base64
                const encKeyBytes = Uint8Array.from(atob(encKeyB64), c => c.charCodeAt(0));
                const cipherBytes = Uint8Array.from(atob(cipherB64), c => c.charCodeAt(0));

                // 2. RSA decrypt AES key
                let rsaKey;
                if (privKey) {
                    rsaKey = privKey;
                } else {
                    // import from PEM
                    rsaKey = await importRsaPrivateKey(privPem);
                    window._rsaPrivateKey = rsaKey; // cache
                }
                const aesKeyRaw = await rsaDecrypt(encKeyBytes, rsaKey);

                // 3. extract IV (first 12 bytes) and ciphertext
                if (cipherBytes.length < 12) throw new Error('Ciphertext too short');
                const iv = cipherBytes.slice(0, 12);
                const ciphertext = cipherBytes.slice(12);

                // 4. AES decrypt
                const plaintext = await aesDecrypt(ciphertext, iv, aesKeyRaw);
                decryptedMessageDisplay.value = plaintext;
                setStatus('✅ Decryption successful! Message revealed.');
            } catch (err) {
                console.error(err);
                setStatus('❌ Decryption failed: ' + err.message, true);
                decryptedMessageDisplay.value = '⚠️ Error';
            }
        }

        // --- paste from sender (copy fields from sender to recipient) ---
        function pasteFromSender() {
            const encKey = encryptedKeyDisplay.textContent;
            const cipher = ciphertextDisplay.textContent;
            if (encKey && encKey !== '—') {
                // just update display, but we also store last values
                window._lastEncryptedKey = encKey;
                window._lastCiphertext = cipher;
                setStatus('📥 Pasted encrypted data from sender.');
            } else {
                setStatus('⚠️ No encrypted data in sender panel.', true);
            }
        }

        // --- random message ---
        function randomMessage() {
            const msgs = [
                '🕵️‍♂️ The eagle flies at midnight.',
                '💎 Diamond hand shake: 42.',
                '🚀 Launch code: 7-4-2-8-1.',
                '🌊 The ocean remembers.',
                '📡 Signal: frequency 142.7 MHz.',
                '🔑 Private key: never share.',
                '📦 Package delivered at pier 3.',
                '⚡ Quantum state: entangled.',
            ];
            plaintextInput.value = msgs[Math.floor(Math.random() * msgs.length)];
        }

        // --- copy helpers ---
        function copyText(text, label) {
            if (!text || text === '—') {
                setStatus('⚠️ Nothing to copy.', true);
                return;
            }
            navigator.clipboard.writeText(text).then(() => {
                setStatus(`📋 ${label} copied to clipboard.`);
            }).catch(() => {
                // fallback
                const ta = document.createElement('textarea');
                ta.value = text;
                document.body.appendChild(ta);
                ta.select();
                document.execCommand('copy');
                ta.remove();
                setStatus(`📋 ${label} copied (fallback).`);
            });
        }

        // --- clear functions ---
        function clearSender() {
            plaintextInput.value = '';
            encryptedKeyDisplay.textContent = '—';
            ciphertextDisplay.textContent = '—';
            window._lastEncryptedKey = null;
            window._lastCiphertext = null;
            setStatus('🧹 Sender cleared.');
        }
        function clearRecipient() {
            decryptedMessageDisplay.value = '—';
            rsaPrivateKeyInput.value = '';
            window._rsaPrivateKey = null;
            setStatus('🧹 Recipient cleared.');
        }

        // --- event binding ---
        encryptBtn.addEventListener('click', handleEncrypt);
        decryptBtn.addEventListener('click', handleDecrypt);
        generateRsaBtn.addEventListener('click', async () => {
            await generateRSAKeyPair();
            // if we have a private key, store it
        });
        randomMsgBtn.addEventListener('click', randomMessage);
        clearSenderBtn.addEventListener('click', clearSender);
        clearRecipientBtn.addEventListener('click', clearRecipient);
        pasteFromSenderBtn.addEventListener('click', pasteFromSender);
        copyEncryptedKeyBtn.addEventListener('click', () => {
            const val = encryptedKeyDisplay.textContent;
            copyText(val, 'Encrypted AES key');
        });
        copyCiphertextBtn.addEventListener('click', () => {
            const val = ciphertextDisplay.textContent;
            copyText(val, 'Ciphertext');
        });

        // on load generate demo RSA keys for convenience
        window.addEventListener('load', async () => {
            await generateRSAKeyPair();
            setStatus('🚀 RSA keys generated. You can now encrypt messages.');
            // set a demo message
            plaintextInput.value = 'Secure message via AES+RSA hybrid.';
        });

        // store public key when generated
        // also if user pastes private key, we try to extract public? not needed, just use for decrypt.
        // but we keep public key in window for encryption after generation.
        // if they paste private key manually, we can't easily get public, but we can still decrypt.

        // additional: if private key input changes, we clear cached private key
        rsaPrivateKeyInput.addEventListener('change', () => {
            window._rsaPrivateKey = null;
        });
    })();
</script>
</body>
</html>
